#
# 이 파일을 복사해 server/.env 로 저장하고 실제 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ .env 는 절대 커밋하지 마세요(.gitignore 에 이미 제외됨).
# ⚠️ API 키는 오직 이 백엔드에서만 사용합니다. 브라우저/프런트에는 두지 않습니다.

# Anthropic API 키 (콘솔에서 발급: https://console.anthropic.com/ )
# 형식 예시일 뿐 실제 키가 아닙니다. 아래 자리표시자를 본인 키로 교체하세요.
ANTHROPIC_API_KEY=PUT-YOUR-KEY-HERE

# AI 프록시가 리슨할 포트(기본 8788)
PORT=8788

# ─── 비용/품질 튜닝(모두 선택) ───
# 비용 우선 기본 모델. 품질이 더 필요하면 claude-sonnet-5 또는 claude-opus-5 로 상향.
# AI_MODEL=claude-haiku-4-5
# 태스크당 출력 상한(기본 700). 정말 필요한 태스크만 상향.
# AI_MAX_TOKENS=700
# Haiku 가 아닌 모델에서만 적용되는 effort(low|medium|high).
# AI_EFFORT=low
# 월간 토큰 예산(초과 시 429 {fallback:true} → 프런트가 mock 으로 자동 폴백).
# AI_MONTHLY_TOKEN_CAP=2000000
# IP당 분당 요청 제한.
# AI_RATE_PER_MIN=20
